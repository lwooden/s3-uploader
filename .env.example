# AWS region for S3 bucket
VITE_AWS_REGION=us-east-1

# Target S3 bucket name
VITE_S3_BUCKET=EXAMPLE-BUCKET-NAME

# Optional key prefix (.e.g subfolder for uploads)
VITE_S3_KEY_PREFIX=EXAMPLE-KEY-PREFIX

# Upload ACL (private | public-read)
VITE_S3_UPLOAD_ACL=private

# AWS Credential
VITE_AWS_ACCESS_KEY_ID="EXAMPLE-ACCESS-KEY-ID"
VITE_AWS_SECRET_ACCESS_KEY="EXAMPLE-SECRET-ACCESS-KEY"

# Optional
VITE_AWS_SESSION_TOKEN="EXAMPLE-SESSION-TOKEN"

# Project name
VITE_PROJECT_NAME="EXAMPLE-PROJECT-NAME"


# Cloudwatch Config
VITE_CLOUDWATCH_LOG_GROUP_NAME="EXAMPLE-LOG-GROUP-NAME"
VITE_CLOUDWATCH_LOG_STREAM_NAME="EXAMPLE-LOG-STREAM-NAME"

# OIDC (Entra ID / Azure AD SPA — use Application client ID GUID, no secret)
# Issuer is typically https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0
VITE_OIDC_ISSUER_URI="EXAMPLE-NAME-ISSUER-URI"
VITE_OIDC_CLIENT_ID="EXAMPLE-CLIENT-ID"


